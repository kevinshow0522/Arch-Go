    {
      "id": "T06_S1",
      "title": "崔愷，差点当航海王的建筑师｜当代建筑师访谈录",
      "url": "https://www.archcollege.com/45976.html",
      "author_role": "黄元炤提问、崔愷回答；应区分二人话语",
      "source_class": "作者第一人称访谈，建筑学院载体",
      "read_scope": "直连多次超时；通过该URL搜索索引阅读大量连续问答，涵盖丰泽园、外研社、德胜尚城、本土概念与形式差异。不声称已打开完整页面或通读访谈全文。",
      "locator": [
        "以“而在北京丰泽园饭店设计时”开头的回答",
        "外研社大兴会议中心场地原为仓储区的回答",
        "德胜尚城为转折点及城市尺度的回答",
        "以“形式实际上不是关注的重点”开头的回答"
      ],
      "supports": [
        "室外活动空间属于广义功能",
        "空间组织可重排功能块",
        "城市肌理和路径关系",
        "不同项目允许形式差异"
      ],
      "limits": [
        "访谈提问中的TEAM 10、涵构主义等归类不是作者自定法则",
        "丰泽园层数在提问与回答中有差别，判断卡不记精确层数",
        "同一来源搜索片段不计为多个来源"
      ]
    },
    {
      "id": "T06_S2",
      "title": "面向中国本土的理性主义设计方法——崔愷院士访谈",
      "url": "https://www.archcy.com/point/gdbl/759e245c9ca5bce9",
      "author_role": "崔愷、范路对谈；范路为《建筑学报》特约编辑",
      "source_class": "2019年《建筑学报》第5期访谈的公开全文转载，网页标明来源",
      "publication": "《建筑学报》2019年第5期；网页转载日2019-09-16",
      "read_scope": "已读转载全文的全部问答、图1–25标题和文末项目信息；未将该网页等同于《本土设计II》原书全文。图纸视觉另由项目研究处理。",
      "locator": [
        "正文关键问题/精准设计回答；网页行119–127",
        "校园穿越、底层开放及管理范围上移；行144–149",
        "绿化与冬季舒适性自评；行170",
        "内外语言与斜撑；行203–212",
        "结构界面、设备和灯具；行228",
        "室内采购与景观遗憾；行231",
        "校园寿命、可持续方向；行242–253"
      ],
      "supports": [
        "问题识别优先于盲目覆盖比较",
        "剖面组织公共与管理",
        "总体到构造的语言协调",
        "承认性能和运营未达意图"
      ],
      "limits": [
        "研究卡片的备选动作、指标和验证流程是本次原创提案，不冒充作者逐字方法",
        "旁边水塘、绿化等未实现意图不能作为建成事实",
        "勿把范路的文化解释直接作为崔愷自述"
      ]
    },
